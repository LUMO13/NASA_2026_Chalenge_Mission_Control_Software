# Binaries are prebuilt by Cargo outside rpmbuild; there is no source tree
# within the RPM build stage for an automatic -debugsource subpackage.
# Fedora RPM would otherwise fail with: Empty %files file debugsourcefiles.list
%global debug_package %{nil}

Name:           fpecs
Version:        @VERSION@
Release:        1%{?dist}
Summary:        FPECS simulated astronaut health monitoring prototype
License:        MIT
Source0:        fpecs-package.tar.gz
BuildArch:      x86_64

%description
Research and demonstration prototype for simulated astronaut health monitoring.
The app is not medical-grade. It supports optional PostgreSQL storage and offline local snapshots.

%prep
%setup -q -n fpecs-package

%build
# Native Rust binaries were compiled by scripts/04_build_release.sh.

%install
install -Dm0755 desktop-gui %{buildroot}%{_bindir}/desktop-gui
install -Dm0755 sensor-simulator %{buildroot}%{_bindir}/sensor-simulator
install -Dm0755 telemetry-receiver %{buildroot}%{_bindir}/telemetry-receiver
install -Dm0755 telemetry-distributor %{buildroot}%{_bindir}/telemetry-distributor
install -Dm0644 fpecs.desktop %{buildroot}%{_datadir}/applications/fpecs.desktop
%{_datadir}/icons/hicolor/scalable/apps/fpecs.svg
install -Dm0644 fpecs.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/fpecs.svg
install -Dm0755 fpecs-db-setup %{buildroot}%{_bindir}/fpecs-db-setup
install -Dm0644 migrations/001_initial_schema.sql %{buildroot}%{_datadir}/fpecs/migrations/001_initial_schema.sql
install -Dm0644 migrations/002_runtime_snapshot.sql %{buildroot}%{_datadir}/fpecs/migrations/002_runtime_snapshot.sql

%files
%license LICENSE
%doc README.md
%{_bindir}/desktop-gui
%{_bindir}/sensor-simulator
%{_bindir}/telemetry-receiver
%{_bindir}/telemetry-distributor
%{_bindir}/fpecs-db-setup
%{_datadir}/fpecs/migrations/001_initial_schema.sql
%{_datadir}/fpecs/migrations/002_runtime_snapshot.sql
%{_datadir}/applications/fpecs.desktop
%{_datadir}/icons/hicolor/scalable/apps/fpecs.svg
